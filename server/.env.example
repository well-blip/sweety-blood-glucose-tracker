# Copy to .env:  cp .env.example .env
# These values match docker-compose.yml. They are local development defaults, not real secrets.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://sweety:sweety@localhost:5433/sweety
# Separate database used only by automated tests
DATABASE_URL_TEST=postgresql://sweety:sweety@localhost:5433/sweety_test

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Time zone that decides what "today" is (for the "Date cannot be in the future." rule and reports)
APP_TIMEZONE=Asia/Kolkata

# Redis (from docker-compose): caches reports and holds the background job queue.
# Leave REDIS_URL empty to run without a cache; emailing reports then reports "not available".
REDIS_URL=redis://localhost:6380/0
# Tests use a separate Redis database number, so they never clear your dev cache
REDIS_URL_TEST=redis://localhost:6380/1

# Outgoing email for "send report to my doctor". These point at Mailpit from docker-compose,
# a local fake mail server: nothing leaves your computer. Read the emails at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Sweety <reports@sweety.local>
